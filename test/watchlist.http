@PORT = 3001
@host_name = "127.0.0.1"
@token = 
@userId = 
@watchlistItemId = 

### ============================================================
### PRUEBAS DEL MÓDULO DE WATCHLIST
### ============================================================

### 1. LOGIN - Obtener token para pruebas autenticadas
POST http://{{host_name}}:{{PORT}}/api/auth/ingresar HTTP/1.1
Content-Type: application/json

{
    "email": "admin@test.com",
    "password": "Admin1234"
}

### ============================================================
### CREAR ITEMS DE WATCHLIST
### ============================================================

### 2. Crear nuevo item - Serie
POST http://{{host_name}}:{{PORT}}/api/watchlist HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "titulo": "Breaking Bad",
    "tipo": "serie",
    "genero": "Drama",
    "calificacion": 9,
    "estatus": "watched",
    "imgPortada": "https://example.com/breaking-bad.jpg",
    "notas": "Una de las mejores series de todos los tiempos"
}

### 3. Crear nuevo item - Película
POST http://{{host_name}}:{{PORT}}/api/watchlist HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "titulo": "Inception",
    "tipo": "movie",
    "genero": "Ciencia Ficción",
    "calificacion": 8,
    "estatus": "watched",
    "imgPortada": "https://example.com/inception.jpg",
    "notas": "Película de Christopher Nolan muy creativa"
}

### 4. Crear item con estatus pending (por defecto)
POST http://{{host_name}}:{{PORT}}/api/watchlist HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "titulo": "The Last of Us",
    "tipo": "serie",
    "genero": "Drama",
    "genero": "Ciencia Ficción"
}

### 5. Crear item con estatus watching
POST http://{{host_name}}:{{PORT}}/api/watchlist HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "titulo": "The Office",
    "tipo": "serie",
    "genero": "Comedia",
    "estatus": "watching",
    "notas": "Viendo actualmente"
}

### 6. Intentar crear sin título
POST http://{{host_name}}:{{PORT}}/api/watchlist HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "tipo": "serie",
    "genero": "Drama"
}

### 7. Intentar crear sin tipo
POST http://{{host_name}}:{{PORT}}/api/watchlist HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "titulo": "Aquí viene el sol",
    "genero": "Drama"
}

### 8. Intentar crear sin género
POST http://{{host_name}}:{{PORT}}/api/watchlist HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "titulo": "Oppenheimer",
    "tipo": "movie"
}

### 9. Intentar crear con tipo inválido
POST http://{{host_name}}:{{PORT}}/api/watchlist HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "titulo": "Interstellar",
    "tipo": "documental",
