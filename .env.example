# Watchlist App Environment Configuration Template

# ============================================
# SERVER CONFIGURATION
# ============================================

# Port where the Express server will listen
# Default: 3000
PUERTO=3000

# ============================================
# DATABASE CONFIGURATION
# ============================================

# MongoDB connection URI
# Format: mongodb://[username]:[password]@[host]:[port]/[database]
#
# For local development with Docker Compose:
# - Run: docker-compose up -d
# - Use: mongodb://admin:toor@localhost:27017/watchlist
#
# For production:
# - Use MongoDB Atlas or managed service
# - Example: mongodb+srv://user:pass@cluster.mongodb.net/watchlist
DATABASE_URI=mongodb://admin:toor@localhost:27017/watchlist

# ============================================
# OPTIONAL CONFIGURATION
# ============================================

# Node environment
# Values: development, production, test
# Default: development (inferred from NODE_ENV if not set)
NODE_ENV=development

JWT_SECRET=
